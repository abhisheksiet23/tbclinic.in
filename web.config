<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- MIME Types -->
    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- ⿡ Redirect http://www.tbclinic.in → https://tbclinic.in -->
        <rule name="Redirect to HTTPS - Non-WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^www\.tbclinic\.in$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://tbclinic.in/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- ⿢ Redirect http://tbclinic.in → https://tbclinic.in -->
        <rule name="Redirect HTTP Non-WWW to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^tbclinic\.in$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://tbclinic.in/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- ⿣ Angular SPA routing -->
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}"
                 pattern="\.(js|mjs|css|png|jpe?g|gif|ico|svg|woff2?|ttf|eot|json|webmanifest)$"
                 negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=31536000" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>