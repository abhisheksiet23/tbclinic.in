<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- MIME Types -->
    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- ⿡ Redirect any www host (http or https) → https://tbclinic.in -->
        <rule name="Redirect WWW to non-WWW HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.tbclinic\.in$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://tbclinic.in/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- ⿢ Redirect http://tbclinic.in → https://tbclinic.in -->
        <rule name="Redirect HTTP Non-WWW to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^tbclinic\.in$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://tbclinic.in/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- ⿣ Angular client-only routes (no prerendered directory exists for these) -->
        <rule name="Angular Client Routes Fallback" stopProcessing="true">
          <match url="^(thank-you|blog(/.*)?)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

        <!-- Anything else with no matching file/directory is a genuine 404,
             left to fall through to IIS's normal error handling instead of
             being silently masked as a 200 homepage response. -->

      </rules>

      <outboundRules>
        <rule name="No long-lived cache for HTML documents">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </conditions>
          <action type="Rewrite" value="public, max-age=0, must-revalidate" />
        </rule>
      </outboundRules>

    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=31536000" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>